if rchanges <> rchangeslast goto profile_poll_recipes_saved
if rchanges = rsaved goto profile_poll_recipes_saved
rstamp = rchanges
call save_recipes
:profile_poll_recipes_saved
rchangeslast = rchanges
dchanges = registry[1012]
if dchanges <> dchangeslast goto profile_poll_usermode_saved
if dchanges = dsaved goto profile_poll_usermode_saved
dstamp = dchanges
call save_usermode
:profile_poll_usermode_saved
dchangeslast = dchanges
if captured = 0 goto profile_poll
if changes <> saved goto profile_poll
if rchanges <> rsaved goto profile_poll
if dchanges <> dsaved goto profile_poll
quiet = hint
goto profile_poll
