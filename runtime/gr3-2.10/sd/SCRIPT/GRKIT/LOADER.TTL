sendln 'lcmd sh /tmp/gc/SCRIPT/GRKIT/FINISH.SH'
dispstr 'GR_MODULE_LOADER_REJECTED'
end
:write_error
filedelete 'C:\SCRIPT\GRKIT\INSTALL.ERR'
filecreate efh 'C:\SCRIPT\GRKIT\INSTALL.ERR'
if efh < 0 goto write_error_end
int2str line failure
filewriteln efh line
int2str line attempts
filewriteln efh line
fileclose efh
:write_error_end
return
